{
    "experiment_name" : "Rough Surface Contact Automatized Simulation",
    "method": {
      "method_name": "rsc_fem_model",
      "method_options" :{
        "num_simulations":1,
        "result_description" : {
            "write_results" : true
            }
      }
    },
    "driver" :{
        "driver_type"           : "rsc_bem_driver",
        "driver_params"         :{
          "executable_name"    : "bem",
          "driver_options" : ["--delta=[50]", "--input='dummy.dat'"]
        }
    },  
    "parameters" : {
      "material_parameters" : {
        "E" : {
          "type" : "float",
          "size" : 1
        },
        "nu" : {
          "type" : "float",
          "size" : 1
        }
      },
      "geometrical_parameters" : {
        "flagwarm" : {
            "type" : "int",
            "size" : 1
        },
        "csteps" : {
            "type" : "int",
            "size" : 1
        }, 
        "lato" : {
            "type" : "int",
            "size" : 1
        },
        "zref" : {
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 25
        },
        "ampface" : {
            "type" : "int",
            "size" : 1
        },
        "H" : {
            "type"  : "float",
            "size"  : 100,
            "distribution_parameter" : [0.5,0.8] 
        },
        "k_el" : {
            "type" : "int",
            "size" : 1
        },
        "n" : {
            "type" : "int",
            "size" : 1,
            "distribution_parameter" : 2
        },
        "delta" :{
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 40
        },
        "alpha" : {
            "type" : "int",
            "size" : 1
        },
        "errf" : {
            "type" : "int",
            "size" : 1
        },
        "tol" : {
            "type" : "int",
            "size" : 1
        }
      }
    }
  }