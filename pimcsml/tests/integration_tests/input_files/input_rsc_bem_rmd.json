{
    "experiment_name" : "Rough Surface Contact Automatized Simulation",
    "method": {
      "method_name": "rsc_bem_rmd",
      "method_options" :{
        "num_simulations":1,
        "result_description" : {
            "write_results" : true
            }
      }
    },
    "driver" :{
        "driver_type"           : "rsc_bem_driver",
        "driver_params"         :{
          "executable_name"    : "bem",
          "driver_options" : ["--input=dummy.json"]
        }
    },  
    "parameters" : {
      "material_parameters" : {
        "E1" : {
          "type" : "float",
          "size" : 1,
          "distribution_parameter" : 1
        },
        "nu1" : {
          "type" : "float",
          "size" : 1,
          "distribution_parameter" : 0.3
        },
        "E2" : {
          "type" : "float",
          "size" : 1,
          "distribution_parameter" : 1
        },
        "nu2" : {
          "type" : "float",
          "size" : 1,
          "distribution_parameter" : 0.3
        }
      },
      "geometrical_parameters" : {
        "lato" : {
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 1000
        },
        "g0" : {
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 50
        },
        "H" : {
            "type"  : "float",
            "size"  : 50,
            "distribution_parameter" : [0.3, 0.3] 
        },
        "n" : {
            "type" : "int",
            "size" : 1,
            "distribution_parameter" : 3
        },
        "Delta" :{
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 10
        },
        "errf" : {
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 100000000
        },
        "tol" : {
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 0.01
        }
      }
    }
  }