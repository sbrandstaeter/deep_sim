{
    "experiment_name" : "3D Beam Automatized Simulations",
    "method": {
      "method_name": "beam_fem_model",
      "method_options" :{
        "num_simulations":10,
        "result_description" : {
            "write_results" : true,
            "result_file_name" : "results",
            "result_file_format" : "csv" 
            }
      }
    },
    "sampling":{
      "sampling_name": "lhs",
      "sampling_options": {
          "lhs_type" : "classic",
          "criterion": "ratio",
          "iterations": 10 
      }
    },  
    "parameters" : {
      "material_parameters" : {
        "E" : {
          "type" : "float",
          "size" : 10,
          "distribution_parameter" : [50000, 210000]
        },
        "nu" : {
          "type" : "float",
          "size" : 10,
          "distribution_parameter" : [0.2, 0.49]
        }
      },
      "geometrical_parameters" : {
        "L" : {
            "type" : "float",
            "size" : 1,
            "distribution_parameter" : 40 
        },
        "t" : {
            "type" : "float",
            "size" : 10,
            "distribution_parameter" : [1, 3]
        },
        "k" : {
            "type"  : "float",
            "size"  : 10,
            "distribution_parameter" : [1, 3] 
        },
        "x" : {
            "type" : "float",
            "size" : 10,
            "distribution_parameter" : [1, 39]
        },
        "q" :{
            "type" : "float",
            "size" : 10,
            "distribution_parameter" : [-10, -100]
        }
      }
    }
  }